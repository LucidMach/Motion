---
// MapboxMap.astro - 3D Mapbox Container & Controller Coordinator
interface Props {
  initialToken?: string;
}

const { initialToken = import.meta.env.PUBLIC_MAPBOX_TOKEN || "" } =
  Astro.props;
---

<div
  id="map"
  class="absolute inset-0 z-1 h-screen w-screen"
  data-token={initialToken}
>
</div>

<script>
  import { MotionMapController } from "../scripts/map";

  let mapController: MotionMapController | null = null;

  function initMotionMap() {
    if (mapController) return;

    const mapEl = document.getElementById("map");
    const token =
      mapEl?.getAttribute("data-token") ||
      (import.meta.env.PUBLIC_MAPBOX_TOKEN as string) ||
      localStorage.getItem("motion_mapbox_token") ||
      "";

    mapController = new MotionMapController();
    mapController.init("map", token);

    // Wire up command events
    window.addEventListener("motion:cmd:fly-user", () => {
      mapController?.flyToUser();
    });

    window.addEventListener("motion:cmd:toggle-3d", () => {
      const is3D = mapController?.toggle3D();
      window.dispatchEvent(
        new CustomEvent("motion:3d-state", { detail: { is3D } }),
      );
    });

    window.addEventListener("motion:cmd:set-3d", (e: Event) => {
      const is3D = (e as CustomEvent<{ is3D: boolean }>).detail?.is3D;
      if (typeof is3D === "boolean") {
        mapController?.setPerspective(is3D);
      }
    });

    window.addEventListener("motion:cmd:update-token", (e: Event) => {
      const tokenVal = (e as CustomEvent<{ token: string }>).detail?.token;
      if (tokenVal) {
        mapController?.updateToken(tokenVal);
      }
    });

    window.addEventListener("motion:cmd:fly-to", (e: Event) => {
      const detail = (e as CustomEvent<{ coords: [number, number]; zoom?: number; pitch?: number; title?: string; subtitle?: string }>).detail;
      if (detail?.coords) {
        if (detail.title) {
          mapController?.setSearchTarget(detail.coords, detail.title, detail.subtitle);
        } else {
          mapController?.flyTo(detail.coords, detail.zoom ?? 16.5, detail.pitch ?? 60);
        }
      }
    });

    window.addEventListener("motion:cmd:clear-search-target", () => {
      mapController?.clearSearchTarget();
    });

    window.addEventListener("motion:cmd:plot-route", (e: Event) => {
      const detail = (e as CustomEvent<{ route: import('../services/api').RouteResponse }>).detail;
      if (detail?.route) {
        mapController?.plotRoute(detail.route);
      }
    });

    window.addEventListener("motion:cmd:clear-route", () => {
      mapController?.clearRoute();
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initMotionMap);
  } else {
    initMotionMap();
  }

  window.addEventListener("beforeunload", () => {
    mapController?.destroy();
  });
</script>
