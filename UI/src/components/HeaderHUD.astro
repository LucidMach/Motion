---
// HeaderHUD.astro - Top Navigation and Live Status HUD with RTL Location & Accuracy Subtext
---

<header class="header-hud glass-panel" aria-label="Navigation & Region Status Bar">
  <!-- Brand and Dynamic Region Focus -->
  <div class="brand-group">
    <div class="brand-icon-wrapper" title="Motion Transit 3D Engine">
      <svg class="brand-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="12 2 19 21 12 17 5 21 12 2" />
      </svg>
      <div class="brand-glow"></div>
    </div>
    <div class="brand-text">
      <h1 class="brand-title">MOTION</h1>
      <span class="brand-subtitle" id="region-focus-label">Melbourne CBD • Victoria</span>
    </div>
  </div>

  <!-- Header Right Action: Right-to-Left Location Button (Right-aligned text + Crosshair Icon) -->
  <div class="header-actions">
    <button
      id="btn-gps-recenter"
      class="gps-location-card glass-panel"
      title="Click to fly to your current location"
      aria-label="Recenter to my location"
    >
      <!-- Right-aligned text stack on the left -->
      <div class="gps-text-stack">
        <span class="gps-location-name" id="gps-loc-name">My Location</span>
        <span class="gps-accuracy-subtext" id="gps-accuracy-sub">±15m accuracy</span>
      </div>

      <!-- Crosshair Icon container on the right (No blinking dot) -->
      <div class="gps-icon-container">
        <svg class="crosshair-icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
          <path d="M12 2c5.514 0 10 4.486 10 10s-4.486 10-10 10-10-4.486-10-10 4.486-10 10-10zm0-2c-6.627 0-12 5.373-12 12s5.373 12 12 12 12-5.373 12-12-5.373-12-12-12zm-5.91 11c.424-2.507 2.403-4.486 4.91-4.91v-2.021c-3.617.452-6.479 3.314-6.931 6.931h2.021zm6.91-4.91c2.507.423 4.486 2.402 4.91 4.91h2.021c-.452-3.617-3.314-6.479-6.931-6.931v2.021zm4.91 6.91c-.424 2.507-2.403 4.486-4.91 4.91v2.021c3.617-.452 6.479-3.314 6.931-6.931h-2.021zm-6.91 4.91c-2.507-.424-4.486-2.403-4.91-4.91h-2.021c.452 3.617 3.313 6.479 6.931 6.931v-2.021zm1-7.91c-1.104 0-2 .896-2 2s.896 2 2 2 2-.896 2-2-.896-2-2-2z"/>
        </svg>
      </div>
    </button>
  </div>
</header>

<style>
  .header-hud {
    position: absolute;
    top: 20px;
    left: 20px;
    right: 20px;
    height: 64px;
    padding: 0 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    z-index: 10;
    pointer-events: auto;
    background: var(--bg-surface);
    backdrop-filter: var(--blur-glass);
    -webkit-backdrop-filter: var(--blur-glass);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-glass);
  }

  .brand-group {
    display: flex;
    align-items: center;
    gap: 14px;
    user-select: none;
  }

  .brand-icon-wrapper {
    position: relative;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, rgba(56, 189, 248, 0.2), rgba(99, 102, 241, 0.2));
    border: 1px solid rgba(56, 189, 248, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-cyan);
    flex-shrink: 0;
  }

  .brand-icon {
    width: 22px;
    height: 22px;
    filter: drop-shadow(0 0 8px rgba(56, 189, 248, 0.8));
    animation: float-slight 3s ease-in-out infinite alternate;
  }

  @keyframes float-slight {
    0% { transform: translateY(0px) rotate(0deg); }
    100% { transform: translateY(-2px) rotate(2deg); }
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
    overflow: hidden;
  }

  .brand-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    background: linear-gradient(90deg, #ffffff 0%, #38bdf8 60%, #818cf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    line-height: 1.1;
  }

  .brand-subtitle {
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--text-secondary);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 400px;
    transition: color 0.3s ease, opacity 0.3s ease;
  }

  .brand-subtitle.updated {
    color: var(--accent-cyan);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  /* Crosshair Location Card (Right-to-Left Alignment) */
  .gps-location-card {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 8px 6px 16px;
    border-radius: var(--radius-full);
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    cursor: pointer;
    transition: var(--transition-smooth);
    user-select: none;
    outline: none;
  }

  .gps-location-card:hover {
    background: var(--bg-surface-hover);
    border-color: var(--border-glow);
    box-shadow: 0 0 20px rgba(56, 189, 248, 0.25);
    transform: translateY(-1px);
  }

  .gps-location-card:active {
    transform: translateY(0px) scale(0.97);
  }

  .gps-text-stack {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
    gap: 1px;
  }

  .gps-location-name {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.15;
    letter-spacing: 0.01em;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .gps-location-card:hover .gps-location-name {
    color: #ffffff;
  }

  .gps-accuracy-subtext {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--accent-cyan);
    letter-spacing: 0.02em;
    line-height: 1;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .gps-icon-container {
    position: relative;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(56, 189, 248, 0.12);
    border: 1px solid rgba(56, 189, 248, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-cyan);
    flex-shrink: 0;
    transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }

  .gps-location-card:hover .gps-icon-container {
    border-color: var(--accent-cyan);
    background: rgba(56, 189, 248, 0.2);
  }

  .crosshair-icon {
    width: 18px;
    height: 18px;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gps-location-card:hover .crosshair-icon {
    transform: scale(1.12);
  }

  @media (max-width: 768px) {
    .header-hud {
      top: 12px;
      left: 12px;
      right: 12px;
      padding: 0 12px;
      height: 58px;
    }

    .brand-subtitle {
      max-width: 170px;
      font-size: 0.68rem;
    }

    .gps-location-card {
      padding: 4px 6px 4px 12px;
      gap: 8px;
    }

    .gps-icon-container {
      width: 30px;
      height: 30px;
    }

    .crosshair-icon {
      width: 16px;
      height: 16px;
    }

    .gps-location-name {
      font-size: 0.76rem;
    }

    .gps-accuracy-subtext {
      font-size: 0.6rem;
    }
  }

  @media (max-width: 480px) {
    .brand-subtitle {
      display: none;
    }
  }
</style>

<script>
  import type { LocationTelemetry } from '../scripts/mapController';

  const gpsBtn = document.getElementById('btn-gps-recenter');
  const locName = document.getElementById('gps-loc-name');
  const accuracySub = document.getElementById('gps-accuracy-sub');
  const regionLabel = document.getElementById('region-focus-label');

  // Recenter on click
  gpsBtn?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('motion:cmd:fly-user'));
  });

  // Listen to location telemetry updates
  window.addEventListener('motion:location', (event: Event) => {
    const loc = (event as CustomEvent<LocationTelemetry>).detail;
    if (!loc) return;

    if (locName) {
      locName.textContent = loc.locationName || 'My Location';
    }
    if (accuracySub) {
      accuracySub.textContent = `±${loc.accuracy}m accuracy`;
    }
  });

  // Listen to status updates
  window.addEventListener('motion:status', (event: Event) => {
    const { state, message } = (event as CustomEvent<{ state: string; message: string }>).detail || {};
    
    if (state === 'gps_acquiring') {
      if (locName) locName.textContent = 'Acquiring GPS...';
      if (accuracySub) accuracySub.textContent = 'Locating signal';
    } else if (state === 'gps_fallback') {
      if (locName) locName.textContent = 'Melbourne CBD';
      if (accuracySub) accuracySub.textContent = '~15m (Approx)';
    }
  });

  // Listen to spatial region-in-focus changes
  window.addEventListener('motion:region-change', (event: Event) => {
    const regionName = (event as CustomEvent<{ regionName: string }>).detail?.regionName;
    if (regionLabel && regionName) {
      regionLabel.textContent = regionName;
      regionLabel.classList.add('updated');
      setTimeout(() => regionLabel.classList.remove('updated'), 600);
    }
  });
</script>
