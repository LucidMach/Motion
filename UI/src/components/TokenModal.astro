---
// TokenModal.astro - Mapbox Access Token Configuration Modal
---

<div id="token-modal" class="modal-backdrop hidden" aria-hidden="true" role="dialog">
  <div class="modal-content glass-panel">
    <div class="modal-header">
      <div class="modal-title-group">
        <div class="modal-icon">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path>
          </svg>
        </div>
        <div>
          <h2 class="modal-title">Mapbox Configuration</h2>
          <p class="modal-subtitle">Configure your public Mapbox access token</p>
        </div>
      </div>
      <button id="btn-close-modal" class="btn-close" aria-label="Close modal">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div class="modal-body">
      <p class="modal-description">
        To render the 3D map, enter your Mapbox Public Access Token (starts with <code>pk.eyJ...</code>).
      </p>

      <div class="input-group">
        <label for="mapbox-token-input" class="input-label">MAPBOX ACCESS TOKEN</label>
        <div class="input-wrapper">
          <input
            type="text"
            id="mapbox-token-input"
            class="token-input"
            placeholder="pk.eyJ1IjoieW91ci11c2VybmFtZSI..."
            autocomplete="off"
            spellcheck="false"
          />
        </div>
        <span class="input-hint">
          Don't have a token? <a href="https://account.mapbox.com/access-tokens/" target="_blank" rel="noopener noreferrer">Get a free token on Mapbox</a>
        </span>
      </div>

      <div class="modal-actions">
        <button id="btn-save-token" class="btn-save">
          <span>Apply & Load 3D Map</span>
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .modal-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(3, 7, 18, 0.75);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
    opacity: 1;
    visibility: visible;
    transition: var(--transition-smooth);
  }

  .modal-backdrop.hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .modal-content {
    width: 90%;
    max-width: 480px;
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-glow);
    padding: 24px;
    border-radius: var(--radius-lg);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6), 0 0 30px rgba(56, 189, 248, 0.15);
    display: flex;
    flex-direction: column;
    gap: 20px;
    animation: modalIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes modalIn {
    from {
      transform: scale(0.92) translateY(12px);
      opacity: 0;
    }
    to {
      transform: scale(1) translateY(0);
      opacity: 1;
    }
  }

  .modal-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }

  .modal-title-group {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .modal-icon {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-md);
    background: rgba(56, 189, 248, 0.12);
    border: 1px solid rgba(56, 189, 248, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-cyan);
  }

  .modal-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .modal-subtitle {
    font-size: 0.78rem;
    color: var(--text-secondary);
  }

  .btn-close {
    background: transparent;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 4px;
    border-radius: var(--radius-sm);
    transition: var(--transition-smooth);
  }

  .btn-close:hover {
    color: var(--text-primary);
    background: var(--bg-surface-hover);
  }

  .modal-body {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .modal-description {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .modal-description code {
    font-family: var(--font-mono);
    background: rgba(15, 23, 42, 0.8);
    padding: 2px 5px;
    border-radius: 4px;
    color: var(--accent-cyan);
    font-size: 0.82rem;
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .input-label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .token-input {
    width: 100%;
    background: rgba(5, 7, 13, 0.8);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 12px 14px;
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    outline: none;
    transition: var(--transition-smooth);
  }

  .token-input:focus {
    border-color: var(--accent-cyan);
    box-shadow: 0 0 0 3px rgba(56, 189, 248, 0.2);
  }

  .input-hint {
    font-size: 0.74rem;
    color: var(--text-muted);
  }

  .input-hint a {
    color: var(--accent-cyan);
    text-decoration: none;
    font-weight: 500;
  }

  .input-hint a:hover {
    text-decoration: underline;
  }

  .modal-actions {
    display: flex;
    justify-content: flex-end;
    margin-top: 8px;
  }

  .btn-save {
    background: linear-gradient(135deg, #0284c7 0%, #4f46e5 100%);
    border: 1px solid rgba(56, 189, 248, 0.5);
    color: #ffffff;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.85rem;
    padding: 10px 18px;
    border-radius: var(--radius-md);
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    box-shadow: 0 0 16px rgba(56, 189, 248, 0.3);
    transition: var(--transition-smooth);
  }

  .btn-save:hover {
    background: linear-gradient(135deg, #0369a1 0%, #4338ca 100%);
    transform: translateY(-1px);
    box-shadow: 0 0 22px rgba(56, 189, 248, 0.5);
  }
</style>

<script>
  const modal = document.getElementById('token-modal');
  const closeBtn = document.getElementById('btn-close-modal');
  const saveBtn = document.getElementById('btn-save-token');
  const input = document.getElementById('mapbox-token-input') as HTMLInputElement;
  const configBtn = document.getElementById('btn-token-config');

  const openModal = () => {
    if (modal) {
      modal.classList.remove('hidden');
      modal.setAttribute('aria-hidden', 'false');
      const saved = localStorage.getItem('motion_mapbox_token') || '';
      if (input && saved) input.value = saved;
      input?.focus();
    }
  };

  const closeModal = () => {
    if (modal) {
      modal.classList.add('hidden');
      modal.setAttribute('aria-hidden', 'true');
    }
  };

  configBtn?.addEventListener('click', openModal);
  closeBtn?.addEventListener('click', closeModal);
  window.addEventListener('motion:cmd:open-token-modal', openModal);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  saveBtn?.addEventListener('click', () => {
    const val = input?.value.trim();
    if (val) {
      window.dispatchEvent(new CustomEvent('motion:cmd:update-token', { detail: { token: val } }));
      closeModal();
    }
  });

  input?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      saveBtn?.click();
    } else if (e.key === 'Escape') {
      closeModal();
    }
  });

  window.addEventListener('motion:status', (e: Event) => {
    const detail = (e as CustomEvent<{ state: string; message: string }>).detail;
    if (detail?.state === 'needs_token') {
      openModal();
    }
  });
</script>
