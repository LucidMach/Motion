---
// index.astro - Motion 3D Transit & Geolocation Frontend
import '../styles/global.css';
import MapboxMap from '../components/MapboxMap.astro';
import HeaderHUD from '../components/HeaderHUD/HeaderHUD';
import SettingsButton from '../components/SettingsButton/SettingsButton';
import SettingsModal from '../components/SettingsModal/SettingsModal';
import TokenModal from '../components/TokenModal/TokenModal';
import SearchBar from '../components/SearchBar/SearchBar';

const pageTitle = "Motion • 3D Victorian Transit & Live Geolocation";
const pageDescription = "High-performance 3D transit routing and live GPS geolocation navigator with Mapbox 3D Engine.";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="theme-color" content="#05070d" />
    <meta name="description" content={pageDescription} />
    
    <!-- Open Graph / Social Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:site_name" content="Motion Transit Engine" />

    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%2338bdf8'><polygon points='12 2 19 21 12 17 5 21 12 2'/></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Mapbox GL CSS -->
    <link href="https://api.mapbox.com/mapbox-gl-js/v3.10.0/mapbox-gl.css" rel="stylesheet" />

    <title>{pageTitle}</title>

    <script is:inline>
      try {
        const raw = localStorage.getItem('motion_theme_settings');
        const defaultSettings = {
          presetId: 'monochrome',
          lightPreset: 'day',
          mapStyle: 'monochrome',
          glassIntensity: 'standard',
          showGlow: true
        };
        const parsed = raw ? JSON.parse(raw) : defaultSettings;
        if (!raw) {
          localStorage.setItem('motion_theme_settings', JSON.stringify(defaultSettings));
        }

        const presets = {
          monochrome: { deep: '#090b10', surface: 'rgba(15, 20, 28, 0.86)', elevated: 'rgba(24, 30, 42, 0.92)', hover: 'rgba(38, 46, 62, 0.95)', glow: 'rgba(241, 245, 249, 0.35)', cyan: '#f1f5f9', indigo: '#94a3b8', gradient: 'linear-gradient(90deg, #ffffff 0%, #e2e8f0 45%, #94a3b8 100%)', subtle: 'rgba(241, 245, 249, 0.2)' },
          cyberpunk: { deep: '#05070d', surface: 'rgba(10, 15, 29, 0.82)', elevated: 'rgba(16, 24, 46, 0.88)', hover: 'rgba(28, 41, 75, 0.92)', glow: 'rgba(56, 189, 248, 0.4)', cyan: '#38bdf8', indigo: '#818cf8', gradient: 'linear-gradient(90deg, #ffffff 0%, #38bdf8 55%, #818cf8 100%)', subtle: 'rgba(56, 189, 248, 0.15)' },
          spring: { deep: '#06120b', surface: 'rgba(10, 28, 18, 0.85)', elevated: 'rgba(16, 44, 28, 0.9)', hover: 'rgba(26, 64, 40, 0.95)', glow: 'rgba(52, 211, 153, 0.4)', cyan: '#34d399', indigo: '#f472b6', gradient: 'linear-gradient(90deg, #ffffff 0%, #34d399 45%, #f472b6 100%)', subtle: 'rgba(52, 211, 153, 0.18)' },
          summer: { deep: '#040d1c', surface: 'rgba(8, 24, 52, 0.85)', elevated: 'rgba(14, 38, 80, 0.9)', hover: 'rgba(22, 54, 110, 0.95)', glow: 'rgba(251, 191, 36, 0.4)', cyan: '#38bdf8', indigo: '#fbbf24', gradient: 'linear-gradient(90deg, #ffffff 0%, #38bdf8 45%, #fbbf24 100%)', subtle: 'rgba(56, 189, 248, 0.18)' },
          autumn: { deep: '#140905', surface: 'rgba(32, 16, 10, 0.85)', elevated: 'rgba(48, 24, 14, 0.9)', hover: 'rgba(70, 36, 20, 0.95)', glow: 'rgba(251, 146, 60, 0.4)', cyan: '#fb923c', indigo: '#f43f5e', gradient: 'linear-gradient(90deg, #ffffff 0%, #fb923c 45%, #f43f5e 100%)', subtle: 'rgba(251, 146, 60, 0.18)' },
          winter: { deep: '#040714', surface: 'rgba(10, 18, 38, 0.85)', elevated: 'rgba(18, 30, 64, 0.9)', hover: 'rgba(28, 46, 96, 0.95)', glow: 'rgba(103, 232, 249, 0.4)', cyan: '#67e8f9', indigo: '#c084fc', gradient: 'linear-gradient(90deg, #ffffff 0%, #67e8f9 45%, #c084fc 100%)', subtle: 'rgba(103, 232, 249, 0.18)' },
          matrix: { deep: '#020408', surface: 'rgba(6, 14, 12, 0.85)', elevated: 'rgba(10, 24, 20, 0.9)', hover: 'rgba(16, 38, 30, 0.95)', glow: 'rgba(16, 185, 129, 0.35)', cyan: '#10b981', indigo: '#14b8a6', gradient: 'linear-gradient(90deg, #ffffff 0%, #10b981 55%, #14b8a6 100%)', subtle: 'rgba(16, 185, 129, 0.15)' },
          obsidian: { deep: '#020408', surface: 'rgba(6, 14, 12, 0.85)', elevated: 'rgba(10, 24, 20, 0.9)', hover: 'rgba(16, 38, 30, 0.95)', glow: 'rgba(16, 185, 129, 0.35)', cyan: '#10b981', indigo: '#14b8a6', gradient: 'linear-gradient(90deg, #ffffff 0%, #10b981 55%, #14b8a6 100%)', subtle: 'rgba(16, 185, 129, 0.15)' },
          tron: { deep: '#05070c', surface: 'rgba(8, 12, 20, 0.88)', elevated: 'rgba(14, 20, 32, 0.92)', hover: 'rgba(22, 32, 48, 0.96)', glow: 'rgba(0, 243, 255, 0.5)', cyan: '#00f3ff', indigo: '#ff7700', gradient: 'linear-gradient(90deg, #ffffff 0%, #00f3ff 50%, #ff7700 100%)', subtle: 'rgba(0, 243, 255, 0.25)' }
        };
        const p = presets[parsed.presetId] || presets.monochrome || presets.cyberpunk;
        const root = document.documentElement;
        root.style.setProperty('--color-deep', p.deep);
        root.style.setProperty('--color-surface', p.surface);
        root.style.setProperty('--color-surface-elevated', p.elevated);
        root.style.setProperty('--color-surface-hover', p.hover);
        root.style.setProperty('--color-glow', parsed.showGlow !== false ? p.glow : 'rgba(148, 163, 184, 0.15)');
        root.style.setProperty('--color-accent-cyan', p.cyan);
        root.style.setProperty('--color-accent-indigo', p.indigo);
        root.style.setProperty('--color-brand-gradient', p.gradient);
        root.style.setProperty('--color-subtle', p.subtle || 'rgba(148, 163, 184, 0.12)');
        root.setAttribute('data-theme', parsed.presetId || 'monochrome');
      } catch (e) {}
    </script>
  </head>
  <body>
    <main id="app-container" class="relative h-screen w-screen overflow-hidden bg-deep">
      <!-- 3D Mapbox Map Engine -->
      <MapboxMap initialToken={import.meta.env.PUBLIC_MAPBOX_TOKEN} />

      <!-- Top Navigation and Region Status HUD -->
      <HeaderHUD client:load />

      <!-- Bottom-Left Settings Button -->
      <SettingsButton client:load />

      <!-- Settings Configuration Modal (UI Theme & Gesture Controls) -->
      <SettingsModal client:load />

      <!-- Bottom Search Bar & Match Results -->
      <SearchBar client:load />

      <!-- Token Configuration Modal (Triggers on missing token) -->
      <TokenModal client:load />
    </main>
  </body>
</html>
