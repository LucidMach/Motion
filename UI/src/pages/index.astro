---
// index.astro - Motion 3D Transit & Geolocation Frontend
import '../styles/global.css';
import MapboxMap from '../components/MapboxMap.astro';
import HeaderHUD from '../components/HeaderHUD/HeaderHUD';
import TransitDock from '../components/TransitDock/TransitDock';
import SettingsButton from '../components/SettingsButton/SettingsButton';
import SettingsModal from '../components/SettingsModal/SettingsModal';
import TokenModal from '../components/TokenModal/TokenModal';
import SearchBar from '../components/SearchBar/SearchBar';
import NavigationPanel from '../components/NavigationPanel/NavigationPanel';
import HealthCheckGate from '../components/HealthCheckGate/HealthCheckGate';

const pageTitle = "Motion • 3D Victorian Transit & Live Geolocation";
const pageDescription = "High-performance 3D transit routing and live GPS geolocation navigator with Mapbox 3D Engine.";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="theme-color" content="#05070d" />
    <meta name="description" content={pageDescription} />
    
    <!-- Open Graph / Social Meta Tags -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:site_name" content="Motion Transit Engine" />

    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%2338bdf8'><polygon points='12 2 19 21 12 17 5 21 12 2'/></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Mapbox GL CSS -->
    <link href="https://api.mapbox.com/mapbox-gl-js/v3.10.0/mapbox-gl.css" rel="stylesheet" />

    <title>{pageTitle}</title>

    <script is:inline>
      try {
        const raw = localStorage.getItem('motion_theme_settings');
        const defaultSettings = {
          presetId: 'monochrome',
          lightPreset: 'day',
          mapStyle: 'monochrome',
          shadowIntensity: 0.85,
          glassIntensity: 'standard',
          showGlow: true
        };
        const parsed = raw ? JSON.parse(raw) : defaultSettings;
        if (!raw) {
          localStorage.setItem('motion_theme_settings', JSON.stringify(defaultSettings));
        }

        const p = {
          deep: '#090b10',
          surface: 'rgba(15, 20, 28, 0.86)',
          elevated: 'rgba(24, 30, 42, 0.92)',
          hover: 'rgba(38, 46, 62, 0.95)',
          glow: 'rgba(241, 245, 249, 0.35)',
          cyan: '#f1f5f9',
          indigo: '#94a3b8',
          gradient: 'linear-gradient(90deg, #ffffff 0%, #e2e8f0 45%, #94a3b8 100%)',
          subtle: 'rgba(241, 245, 249, 0.2)'
        };
        const root = document.documentElement;
        root.style.setProperty('--color-deep', p.deep);
        root.style.setProperty('--color-surface', p.surface);
        root.style.setProperty('--color-surface-elevated', p.elevated);
        root.style.setProperty('--color-surface-hover', p.hover);
        root.style.setProperty('--color-glow', parsed.showGlow !== false ? p.glow : 'rgba(148, 163, 184, 0.15)');
        root.style.setProperty('--color-accent-cyan', p.cyan);
        root.style.setProperty('--color-accent-indigo', p.indigo);
        root.style.setProperty('--color-brand-gradient', p.gradient);
        root.style.setProperty('--color-subtle', p.subtle || 'rgba(148, 163, 184, 0.12)');
        root.setAttribute('data-theme', 'monochrome');
      } catch (e) {}
    </script>
  </head>
  <body>
    <main id="app-container" class="relative h-screen w-screen overflow-hidden bg-deep">
      <!-- 3D Mapbox Map Engine -->
      <MapboxMap initialToken={import.meta.env.PUBLIC_MAPBOX_TOKEN} />

      <!-- Top Navigation and Region Status HUD -->
      <HeaderHUD client:load />

      <!-- Transit Dock: Train/Tram/Bus route picker -->
      <TransitDock client:load />

      <!-- Bottom-Left Settings Button -->
      <SettingsButton client:load />

      <!-- Settings Configuration Modal (UI Theme & Gesture Controls) -->
      <SettingsModal client:load />

      <!-- Bottom Search Bar & Match Results -->
      <SearchBar client:load />

      <!-- Active Transit Route Navigation HUD -->
      <NavigationPanel client:load />

      <!-- Token Configuration Modal (Triggers on missing token) -->
      <TokenModal client:load />

      <!-- Backend Health Check & Cold-Start Gateway -->
      <HealthCheckGate client:load />
    </main>
  </body>
</html>
